<section style="border-top: 2px solid #dee2e6;" class="clipped py-5">
  <div class="container">
    <div class="mb-5 px-4">
      <p class="has-text-left is-size-3 has-text-weight-medium mb-2">Helpful Links</p>
    </div>
    <div class="columns is-multiline px-4">
      <% for (let index in links) { let link = links[index]; %>
      <div class="column is-12-mobile is-6-tablet is-3-desktop">
        <div
          id="<%= link.id %>-<%= link.name %>"
          class="card has-background-light has-equal-height"
          style="box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;"
        >
          <div>
            <img
              class="pt-6"
              alt="<%= link.name %>"
              src="<%= link.imgUrl %>"
              style="display: block; margin-left: auto; margin-right: auto; max-height: 80%; max-width: 80%; height: auto; width: auto; object-fit: contain;"
            />
          </div>
          <div class="card-content">
            <p class="title is-5 has-text-centered has-text-dark"><%= link.name %></p>
          </div>
          <div class="card-footer">
            <a
              target="_blank"
              href="<%= link.linkUrl %>"
              class="card-footer-item button is-warning"
            >
              Visit Site
            </a>
          </div>
        </div>
      </div>
      <% }; %>
    </div>
  </div>
</section>
