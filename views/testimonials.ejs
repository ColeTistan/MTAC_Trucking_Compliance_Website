<section class="clipped py-5" style="border-top: 2px solid #dee2e6;">
    <div class="container">
        <h2 class="title has-text-centered has-text-dark">
            Testimonials
        </h2>
        <div class="columns is-multiline is-centered">
            <% testimonials.forEach((testimonial, index) => { %>
            <div class="column is-12-mobile is-6-tablet is-4-desktop">
                <div class="card has-equal-height">
                    <div class="card-content">
                        <p class="content is-size-5">
                            "<%= testimonial.quote.slice(0, 135) + "..." %>"
                        </p>
                        <p class="has-text-right is-size-6 has-text-weight-medium">
                            - <%= testimonial.personName %>, <%= testimonial.companyName %>
                        </p>
                    </div>
                    <div class="card-footer">
                        <button class="button is-warning is-fullwidth js-modal-trigger" data-target="modal-testimonial-<%= index %>">
                            Read Full Testimonial
                        </button>
                    </div>
                </div>
                
                <!-- Modal for this testimonial -->
                <div id="modal-testimonial-<%= index %>" class="modal">
                    <div class="modal-background"></div>
                    <div class="modal-card">
                        <header class="modal-card-head" style="margin-bottom: 0;">
                            <p class="modal-card-title has-text-light" style="line-height: 1.5;">
                                <strong><%= testimonial.personName.split(",")[0] %></strong><br>
                                <%= testimonial.personName.split(",")[1] %><br>
                                <%= testimonial.companyName %>
                            </p>
                            <button class="delete" aria-label="close"></button>
                        </header>
                        <section class="modal-card-body has-text-light">
                            <div class="content">
                                <blockquote class="is-size-6">
                                    "<%= testimonial.quote %>"
                                </blockquote>
                                <p class="has-text-right is-size-6 has-text-weight-medium mt-4">
                                    <strong>- <%= testimonial.personName %></strong><br>
                                    <%= testimonial.companyName %>
                                </p>
                            </div>
                        </section>
                        <footer class="modal-card-foot">
                            <button class="button" aria-label="close">Close</button>
                        </footer>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</section>