<%- include('./partials/header') %>
<section>
  <div class="container">
    <div class="d-flex justify-content-between align-items-center pb-2">
      <p class="fs-2 align-left m-0">Dashboard</p>
      <a href="/news/create" class="btn btn-outline-secondary">Add Article</a>
    </div>
    <table class="table table-striped align-middle shadow-sm">
      <thead class="table-dark">
        <tr>
          <th scope="col">Article #</th>
          <th scope="col">Article Title</th>
          <th scope="col">Article Description</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach((article) => { %>
        <tr>
          <th scope="row"><%= article.id %></th>
          <td class="text-truncate"><%= article.title %></td>
          <td class="text-truncate"><%= article.description %></td>
          <td>
            <a href="/news/update/<%= article.id %>" class="btn btn-sm btn-info"
              ><img src="img/pencil-square.svg" alt="edit"
            /></a>
            <a href="#" class="btn btn-sm btn-danger"
              ><img src="img/trash3-fill.svg" alt="delete"
            /></a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
<%- include('./partials/footer') %>
