<%- include('./partials/header') %>
<section>
  <div class="container py-5">
    <!-- Header remains the same -->
    <div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
      <p class="is-size-3">Dashboard</p>
      <a href="/news/create" class="button is-warning">Add Article</a>
    </div>

    <!-- Desktop/Tablet Table View -->
    <div class="is-hidden-mobile">
      <div class="table-container">
        <table class="table is-fullwidth is-hoverable" style="box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;">
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% articles.forEach((article) => { %>
            <tr>
              <td><%= article.id %></td>
              <td><%= article.title %></td>
              <td><%= article.description %></td>
              <td>
                <div class="buttons are-small">
                  <a href="/news/update/<%= article.id %>" class="button is-info is-small">
                    <img src="img/pencil-square.svg" alt="edit" style="width: 16px; height: 16px;" />
                  </a>
                  <button class="button is-danger is-small js-modal-trigger" data-target="deleteModal<%= article._id %>">
                    <img src="img/trash3-fill.svg" alt="delete" style="width: 16px; height: 16px;" />
                  </button>
                </div>
                <div id="deleteModal<%= article._id %>" class="modal">
                  <div class="modal-card">
                    <header class="modal-card-head has-background-danger mb-0">
                      <p class="modal-card-title has-text-white">
                        Delete Confirmation
                      </p>
                      <button class="delete" aria-label="close"></button>
                    </header>
                    <section class="modal-card-body">
                      <p class="content">
                        Are you sure you want to delete this article?
                        This action cannot be undone once deleted.
                      </p>
                    </section>
                    <footer class="modal-card-foot">
                      <div class="buttons">
                        <button class="button" type="button">Cancel</button>
                        <form
                          action="/news/delete/<%= article.id %>?_method=DELETE"
                          method="POST"
                          style="display: inline;"
                        >
                          <button type="submit" class="button is-danger">
                            Delete
                          </button>
                        </form>
                      </div>
                    </footer>
                  </div>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Card View -->
    <div class="is-hidden-tablet">
      <% articles.forEach((article) => { %>
      <div class="card mb-4">
        <div class="card-content">
          <div class="media">
            <div class="media-content">
              <p class="title is-6">#<%= article.id %> - <%= article.title %></p>
              <p class="subtitle is-7 has-text-grey"><%= article.description %></p>
            </div>
          </div>
        </div>
        <footer class="card-footer">
          <a href="/news/update/<%= article.id %>" class="card-footer-item button is-info">
            Edit
          </a>
          <button class="card-footer-item button is-danger js-modal-trigger" data-target="deleteModal<%= article._id %>">
            Delete
          </button>
        </footer>

        <!-- Modal for each article -->
        <div id="deleteModal<%= article._id %>" class="modal">
          <div class="modal-background"></div>
          <div class="modal-card">
            <header class="modal-card-head has-background-danger">
              <p class="modal-card-title has-text-white">
                Delete Confirmation
              </p>
              <button class="delete" aria-label="close"></button>
            </header>
            <section class="modal-card-body">
              <p class="content">
                Are you sure you want to delete this article? This action cannot be undone once deleted.
              </p>
            </section>
            <footer class="modal-card-foot">
              <div class="buttons">
                <button class="button" type="button">Cancel</button>
                <form
                  action="/news/delete/<%= article.id %>?_method=DELETE"
                  method="POST"
                  style="display: inline;"
                >
                  <button type="submit" class="button is-danger">
                    Delete Article
                  </button>
                </form>
              </div>
            </footer>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<%- include('./partials/footer') %>
