<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') -%>
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <header class="m-0"><%- include('./partials/header') -%></header>
    <main>
      <section class="hero is-medium is-light">
        <div class="hero-body">
          <div class="container has-text-centered">
            <div class="columns is-2">
              <div class="column box is-4 is-offset-4 has-background-white p-5" style="box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;">
                <h1 class="title is-3-mobile is-2-tablet">Employee Login</h1>
                <form action="/login" method="post">
                  <div class="field">
                    <p class="control">
                      <input class="input is-medium has-background-light has-text-dark" type="email" name="email" placeholder="Email" required />
                    </p>
                  </div>
                  <div class="field">
                    <p class="control">
                      <input class="input is-medium has-background-light has-text-dark" type="password" name="password" placeholder="Password" required />
                    </p>
                  </div>
                  <div class="field">
                    <p class="control">
                      <button class="button is-warning is-fullwidth is-medium has-text-dark" type="submit">Login</button>
                    </p>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>
