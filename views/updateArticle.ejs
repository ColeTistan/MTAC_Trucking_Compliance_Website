<%- include('./partials/header') -%>
  <section class="container">
    <div
      class="col-md-9 col-lg-6 g-3 mx-auto py-3 px-4 mt-5 border rounded bg-light shadow"
    >
      <form
        action="/news/update/<%= article.id %>?_method=PUT"
        method="post"
        enctype="multipart/form-data"
      >
        <p class="text-left fs-3 fw-medium">Update an Article</p>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="exampleInputTitle1"
            aria-describedby="titleHelp"
            type="hidden"
            name="title"
            value="<%= article.title %>"
            required
          />
          <label for="floatingInput">Article Title</label>
        </div>
         <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="exampleInputDescription1"
            name="description"
            value="<%= article.description %>"
            required
          />
          <label for="floatingInput">Article Description</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="exampleInputURL1"
            name="url"
            value="<%= article.url %>"
          />
          <label for="floatingInput">Article URL</label>
        </div>
        <div class="mb-3">
          <label for="formFile" class="form-label">Image File</label>
          <input class="form-control" type="file" name="image" id="formFile" value="<%= article.image %>">
        </div>
        <div class="mb-3">
          <label for="formFile" class="form-label">PDF File</label>
          <input class="form-control" type="file" name="file" id="formFile" value="<%= article.file %>">
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" value="false" name="isFeatured" id="flexCheckDefault">
          <label class="form-check-label" for="flexCheckDefault">
            Featured Article?
          </label>
        </div>
        <br />
        <input type="submit" class="btn btn-primary w-100" />
      </form>
    </div>
  </section>
</main>
<%- include('./partials/footer') -%>
