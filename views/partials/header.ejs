<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('head') -%>
  </head>
  <body class="d-flex flex-column min-vh-100 has-background-light has-text-dark overflow-x-hidden">
    <header class="m-0">
      <nav class="navbar has-background-dark px-5" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
          <a class="brand-logo" href="/">
            <img src="/img/company_logo.png" alt="MTAC Company Logo">
          </a>

          <a role="button" class="navbar-burger has-text-light" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </a>
        </div>

        <div id="navbarBasicExample" class="navbar-menu has-background-dark">
          <div class="navbar-start">
            <a href="/" class="navbar-item has-text-centered">
              Home
            </a>
            <a href="/about" class="navbar-item has-text-centered">
              About
            </a>
            <a href="/insight" class="navbar-item has-text-centered">
              Insights
            </a>
            <a href="/contact" class="navbar-item has-text-centered">
              Contact
            </a>
          </div>

          <div class="navbar-end">
            <div class="navbar-item has-text-centered">
              <div class="buttons is-centered">
                <% if (!token) { %>
                  <a class="button is-warning" href="/login">
                    Employee Login
                  </a>
                <% } else { %>
                  <a class="button is-primary" href="/dashboard">
                    Dashboard
                  </a>
                  <a class="button is-link" href="/img/M-Tac_Employee_Web_App_Manual.pdf" target="_blank">
                    User Manual
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <main class="overflow-x-hidden">
      <section id="hero-img">
        <div class="">
          <img
            class="hero-img"
            src="/img/banner_img.png"
            alt="inspection two"
          />
        </div>
      </section>
    </main>
  </body>
  <script src="/assets/misc.js"></script>
</html>
