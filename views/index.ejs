<%- include('./partials/header') -%>
  <section id="company-safety-solutions">
    <div class="container">
      <div class="columns is-multiline px-4 has-text-centered is-size-5 mt-3 mb-5">
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <img class="p-2" src="/img/tools.svg" alt="tools" />
          <p>Compliance and Safety Consulting</p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <img class="p-2" src="/img/checklist.svg" alt="checklist" />
          <p>Safety Audit Preparation &amp; Representation</p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <img class="p-2" src="/img/book.svg" alt="book" />
          <p>
            Customized training in all compliance areas, including record keeping requirements,
            load securement, and more.
            <br />(Virtual &amp; In-Person)
          </p>
        </div>
      </div>
    </div>
  </section>
  <section style="border-top: 2px solid #dee2e6;" class="clipped py-5">
    <div class="container">
      <div class="mb-5 px-4">
        <p class="has-text-left is-size-4 has-text-weight-medium mb-2">Featured</p>
        <p class="has-text-left is-size-3 has-text-weight-medium">New and Noteworthy</p>
      </div>
      <div class="columns is-multiline px-4">
        <% featuredArticles.forEach((article) => { %>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div class="card has-equal-height">
            <div style="width: 100%;" class="card-image">
              <img src="/image/<%= article.image %>" alt="<%= article.title %>" class="card-img-top" />
            </div>
            <div class="card-content">
              <p class="title is-5"><%= article.title %></p>
              <p class="content is-size-6"><%= article.description %></p>
            </div>
            <div class="card-footer">
              <% if (!article.file) { %>
                <a
                  target="_blank"
                  href="<%= article.url %>"
                  class="card-footer-item button is-warning"
                >
                  Read Article
                </a>
              <% } else { %>
                <a
                  target="_blank"
                  href="/pdf/<%= article.file %>"
                  class="card-footer-item button is-warning"
                >
                  Download PDF
                </a>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <div class="powr-hit-counter powrLoaded" id="d0465e39_1598232449">
    <iframe
      src="https://www.powr.io/hit-counter/u/d0465e39_1598232449#platform=bootstrap?&amp;url=http%3A%2F%2Fmtactruckingcompliance.com%2Findex.html"
      powrindex="0"
      width="100%"
      height="71px"
      frameborder="0"
      webkitallowfullscreen=""
      mozallowfullscreen=""
      allowfullscreen=""
      style="
        height: 71px;
        transition: height 0.3s ease 0s;
        display: inline;
        visibility: visible;
      "
    ></iframe>
  </div>
  <script src="https://www.powr.io/powr.js?platform=bootstrap?"></script>

  <%- include('./partials/footer') -%>
</main>
