<%- include('./partials/header') -%>
  <section>
    <div
      class="columns is-1-mobile is-0-tablet is-3-desktop is-8-widescreen is-2-fullhd container my-6 is-variable is-8"
    >
      <div class="column">
        <h1 class="title is-2 is-3-mobile is-2-tablet has-text-dark">Our Services</h1>
        <table class="table has-background-light has-text-dark is-bordered rounded is-hoverable is-fullwidth">
          <tbody>
            <tr>
              <td>US DOT Compliance Services</td>
            </tr>
            <tr>
              <td>Safety Audit & Compliance Review Representation</td>
            </tr>
            <tr>
              <td>CSA Safety Rating Improvement Strategies</td>
            </tr>
            <tr>
              <td>HOS / ELD Regulations</td>
            </tr>
            <tr>
              <td>Annual Vehicle Inspections (49 CFR 396)</td>
            </tr>
            <tr>
              <td>Post Crash Inspections & Guidance</td>
            </tr>
            <tr>
              <td>Driver File Management</td>
            </tr>
            <tr>
              <td>Vehicle Maintenance Files</td>
            </tr>
            <tr>
              <td>Guidance for USDOT and State Statutes</td>
            </tr>
            <tr>
              <td>Data Queries / Challenges</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="column box has-background-white p-5"
        style="box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;"
      >
        <h1 class="title is-2 has-text-dark">Contact Us</h1>
        <form
          target="_blank"
          action="https://formsubmit.co/mtactruckingcompliance@gmail.com"
          method="POST"
        >
          <div class="field">
            <p class="control">
              <input
                class="input is-medium has-background-light has-text-dark"
                type="text"
                name="user_name"
                placeholder="User Name (e.g. John Doe)"
                required
              />
            </p>
          </div>
          <div class="field">
            <p class="control">
              <input
                class="input is-medium has-background-light has-text-dark"
                type="email"
                name="email"
                placeholder="Email"
                required
              />
            </p>
          </div>
          <div class="field">
            <div class="control">
              <textarea
                name="message"
                class="textarea has-background-light has-text-dark"
                placeholder="Explain how we can help you"
                rows="9"
                required
              ></textarea>
            </div>
          </div>
          <div class="field">
            <div class="control">
              <button type="submit" class="button is-warning is-fullwidth is-medium">
                Submit
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>
<%- include('./partials/footer') -%>