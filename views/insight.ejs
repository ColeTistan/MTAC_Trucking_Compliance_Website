<%- include('./partials/header') %>
<section id="insight-video-section" class="py-1">
  <div class="container">
    <h3 class="has-text-left is-size-3 has-text-weight-medium mt-3">Industry Insights</h3>
  </div>
</section>
<section
  id="insight-cards-section"
  class="clipped py-5"
>
  <div class="container">
    <div class="columns is-multiline px-4">
      <% articles.forEach((article) => { %>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div
            class="card has-equal-height"
          >
            <div style="width: 100%;" class="card-image">
              <img
                class="card-image-top"
                src="/image/<%= article.image %>"
                alt="<%= article.title %>"
              />
            </div>
            <div class="card-content">
              <p class="title is-5"><%= article.title %></p>
              <p class="content is-size-6"><%= article.description %></p>
            </div>
            <div class="card-footer">
              <% if (!article.file) { %>
                <a
                  target="_blank"
                  href="<%= article.url %>"
                  class="card-footer-item button is-warning"
                >
                  Read Article
                </a>
              <% } else { %>
                <a
                  target="_blank"
                  href="/pdf/<%= article.file %>"
                  class="card-footer-item button is-warning"
                >
                  Download PDF
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<%- include('./links') %>
</main>
<%- include('./partials/footer') %>
