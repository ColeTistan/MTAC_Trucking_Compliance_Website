<%- include('./partials/header') %>
<section id="insight-video-section" class="py-1">
  <div class="container">
    <h3 class="align-left">Industry Insights</h3>
  </div>
</section>
<section
  id="insight-cards-section"
  class="border-2 border-dark-subtle overflow-x-hidden p-4"
>
  <div class="container">
    <div class="row text-center g-4">
      <% articles.forEach((article) => { %>
        <div class="col-sm-1 col-md-6 col-lg-4 col-xl-3">
          <div
            class="card card-block bg-light h-100 text-center shadow-sm mb-5 rounded"
          >
            <img class="card-image-top" src="/image/<%= article.image %>" />
            <div class="card-body align-items-center justify-content-center">
              <p class="card-title fs-5"><%= article.title %></p>
              <p class="card-text"><%= article.description %></p>
            </div>
            <div
              class="card-footer d-flex justify-content-center align-items-center"
            >
            <% if (!article.url) { %>
              <a
                target="_blank"
                href="/pdf/<%= article.file %>"
                class="bg-primary text-light fw-medium text-decoration-none rounded w-50 p-2"
              >
                Click here
              </a>
            <% } else { %>
              <a
                target="_blank"
                href="<%= article.url %>"
                class="bg-primary text-light fw-medium text-decoration-none rounded w-50 p-2"
              >
                Click here
              </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<%- include('./links') %>
</main>
<%- include('./partials/footer') %>
